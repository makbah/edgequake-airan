# =============================================================================
# PROVIDER SELECTION — uncomment ONE block below
# =============================================================================

# -----------------------------------------------------------------------------
# OPTION A: OpenAI (cloud)
# -----------------------------------------------------------------------------
EDGEQUAKE_LLM_PROVIDER=openai
EDGEQUAKE_EMBEDDING_PROVIDER=openai
EDGEQUAKE_DEFAULT_LLM_PROVIDER=openai
EDGEQUAKE_DEFAULT_LLM_MODEL=gpt-4o-mini
EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=openai
EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=1536
EDGEQUAKE_VISION_PROVIDER=openai
EDGEQUAKE_VISION_MODEL=gpt-4.1-nano
OPENAI_API_KEY=sk-your-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1   # only needed if using a proxy

# -----------------------------------------------------------------------------
# OPTION B: Ollama (local — run: ollama pull gemma3:12b && ollama pull embeddinggemma)
# -----------------------------------------------------------------------------
# EDGEQUAKE_LLM_PROVIDER=ollama
# EDGEQUAKE_EMBEDDING_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_LLM_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_LLM_MODEL=gemma3:12b
# EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=ollama
# EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=embeddinggemma
# EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=768
# EDGEQUAKE_VISION_PROVIDER=ollama
# EDGEQUAKE_VISION_MODEL=llava
# OLLAMA_HOST=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# OPTION C: vLLM (self-hosted, OpenAI-compatible)
# -----------------------------------------------------------------------------
# EDGEQUAKE_LLM_PROVIDER=openai
# EDGEQUAKE_EMBEDDING_PROVIDER=openai
# EDGEQUAKE_DEFAULT_LLM_PROVIDER=openai
# EDGEQUAKE_DEFAULT_LLM_MODEL=meta-llama/Llama-3-8b-instruct
# EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=openai
# EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=your-embedding-model
# EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=1536
# EDGEQUAKE_VISION_PROVIDER=openai
# EDGEQUAKE_VISION_MODEL=your-vision-model
# OPENAI_API_KEY=placeholder          # vLLM accepts any non-empty string
# OPENAI_BASE_URL=http://host.docker.internal:8000/v1

# -----------------------------------------------------------------------------
# OPTION D: LM Studio (local, OpenAI-compatible)
# -----------------------------------------------------------------------------
# EDGEQUAKE_LLM_PROVIDER=lmstudio
# EDGEQUAKE_EMBEDDING_PROVIDER=lmstudio
# EDGEQUAKE_DEFAULT_LLM_PROVIDER=lmstudio
# EDGEQUAKE_DEFAULT_LLM_MODEL=gemma2-9b-it
# EDGEQUAKE_DEFAULT_EMBEDDING_PROVIDER=lmstudio
# EDGEQUAKE_DEFAULT_EMBEDDING_MODEL=nomic-embed-text
# EDGEQUAKE_DEFAULT_EMBEDDING_DIMENSION=768
# LMSTUDIO_HOST=http://host.docker.internal:1234
# LMSTUDIO_MODEL=gemma2-9b-it
# LMSTUDIO_EMBEDDING_MODEL=nomic-embed-text
# LMSTUDIO_EMBEDDING_DIM=768
# EDGEQUAKE_VISION_PROVIDER=lmstudio
# EDGEQUAKE_VISION_MODEL=your-vision-model

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_PASSWORD=edgequake_secret

# =============================================================================
# PORTS (optional — change if defaults conflict with other services)
# =============================================================================
EDGEQUAKE_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432

# =============================================================================
# SERVER
# =============================================================================
HOST=0.0.0.0
PORT=8080
WORKER_THREADS=4

# =============================================================================
# VISION TIMEOUT
# =============================================================================
# Seconds to wait for PDF page vision extraction. Default 600s (10 min).
# Increase if you're processing large PDFs with a slow local model.
EDGEQUAKE_VISION_TIMEOUT_SECS=600

# =============================================================================
# LOGGING
# =============================================================================
RUST_LOG=edgequake=debug,tower_http=debug,axum=debug
